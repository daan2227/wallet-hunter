<?xml version="1.0" encoding="utf-8"?>
<!-- Icono adaptativo: Android le pone la forma (circulo, cuadrado
     redondeado...) segun el movil. El PNG de antes traia las esquinas ya
     redondeadas y el sistema lo metia encogido dentro de otra forma, y el
     simbolo estaba mal dibujado. monochrome: iconos tematicos (Android 13+). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
