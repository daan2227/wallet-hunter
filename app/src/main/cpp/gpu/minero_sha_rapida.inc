uint SG1(uint x) { return ror_(x, 6) ^ ror_(x, 11) ^ ror_(x, 25); }
uint sg0(uint x) { return ror_(x, 7) ^ ror_(x, 18) ^ (x >> 3u); }
uint sg1(uint x) { return ror_(x, 17) ^ ror_(x, 19) ^ (x >> 10u); }
uint CHf(uint x, uint y, uint z) { return z ^ (x & (y ^ z)); }
uint MAJf(uint x, uint y, uint z) { return (x & y) | (z & (x | y)); }

