#version 450
/* Minero en la GPU: cada invocación prueba p.iter nonces seguidos. La SHA-256 está en minero_sha.inc y, desenrollada
 * para la GPU, en minero_sha_rapida.inc (gen_sha_rapida.py); las dos se prueban también como C++. Se genera minero_spv.h con gen_minero.mjs. */
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Params {
    uint mid[8];      // compresión de los 64 primeros bytes
    uint cola[4];     // bytes 64..75 en palabras big-endian (la cuarta, sin usar)
    uint obj[8];      // objetivo, la palabra más significativa primero
    uint base;        // primer nonce
    uint limite;      // cuántos nonces en total
    uint iter;        // nonces por invocación
    uint relleno;
} p;

layout(std430, binding = 1) buffer Resultado {
    uint encontrado;  // menor índice (desde base) que cumple, o 0xffffffff
    uint mejorZ;      // ceros del mejor hash
    uint mejorN;      // índice del mejor (aproximado si dos empatan a la vez)
    uint relleno;
} r;

#define ARR8_IN(n) in uint n[8]
#define ARR8_OUT(n) out uint n[8]
#define ARR16_IN(n) in uint n[16]
#define CLZ(x) (31u - uint(findMSB(x)))

const uint KT[64] = uint[](
    0x428a2f98u,0x71374491u,0xb5c0fbcfu,0xe9b5dba5u,0x3956c25bu,0x59f111f1u,0x923f82a4u,0xab1c5ed5u,
    0xd807aa98u,0x12835b01u,0x243185beu,0x550c7dc3u,0x72be5d74u,0x80deb1feu,0x9bdc06a7u,0xc19bf174u,
    0xe49b69c1u,0xefbe4786u,0x0fc19dc6u,0x240ca1ccu,0x2de92c6fu,0x4a7484aau,0x5cb0a9dcu,0x76f988dau,
    0x983e5152u,0xa831c66du,0xb00327c8u,0xbf597fc7u,0xc6e00bf3u,0xd5a79147u,0x06ca6351u,0x14292967u,
    0x27b70a85u,0x2e1b2138u,0x4d2c6dfcu,0x53380d13u,0x650a7354u,0x766a0abbu,0x81c2c92eu,0x92722c85u,
    0xa2bfe8a1u,0xa81a664bu,0xc24b8b70u,0xc76c51a3u,0xd192e819u,0xd6990624u,0xf40e3585u,0x106aa070u,
    0x19a4c116u,0x1e376c08u,0x2748774cu,0x34b0bcb5u,0x391c0cb3u,0x4ed8aa4au,0x5b9cca4fu,0x682e6ff3u,
    0x748f82eeu,0x78a5636fu,0x84c87814u,0x8cc70208u,0x90befffau,0xa4506cebu,0xbef9a3f7u,0xc67178f2u);
const uint H0T[8] = uint[](0x6a09e667u,0xbb67ae85u,0x3c6ef372u,0xa54ff53au,0x510e527fu,0x9b05688cu,0x1f83d9abu,0x5be0cd19u);

#include "minero_sha.inc"
#include "minero_sha_rapida.inc"

void main() {
    uint idx0 = gl_GlobalInvocationID.x * p.iter;
    uint mid[8]; for (int i = 0; i < 8; i++) mid[i] = p.mid[i];
    uint obj[8]; for (int i = 0; i < 8; i++) obj[i] = p.obj[i];
    uint mejorZ = 0u; uint mejorN = 0u;
    for (uint k = 0u; k < p.iter; k++) {
        uint idx = idx0 + k;
        if (idx >= p.limite) break;
        // Lo normal: sólo la palabra alta, desenrollado y cortado en la ronda 60.
        uint alta = bsw(alta_rapida(mid, p.cola[0], p.cola[1], p.cola[2], p.base + idx));
        uint z = alta != 0u ? CLZ(alta) : 32u;
        // Lo raro (palabra alta a cero, o que puede cumplir el objetivo): el hash entero.
        if (alta == 0u || alta <= obj[0]) {
            uint h[8];
            minar_hash(mid, p.cola[0], p.cola[1], p.cola[2], p.base + idx, h);
            z = ceros(h);
            if (cumple(h, obj)) atomicMin(r.encontrado, idx);
        }
        if (z > mejorZ) { mejorZ = z; mejorN = idx; }
    }
    uint antes = atomicMax(r.mejorZ, mejorZ);
    if (mejorZ > antes) r.mejorN = mejorN;
}
