void mul8(uint a0, uint a1, uint a2, uint a3, uint a4, uint a5, uint a6, uint a7, uint b0, uint b1, uint b2, uint b3, uint b4, uint b5, uint b6, uint b7, out uint r0, out uint r1, out uint r2, out uint r3, out uint r4, out uint r5, out uint r6, out uint r7) {
