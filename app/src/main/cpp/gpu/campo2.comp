        uint k, k2;
        uint add1 = uaddCarry(hi0, lo1, k); uint add1c = k; add1 = uaddCarry(add1, h0, k); add1c += k;
        uint add2 = uaddCarry(hi1, h1, k); uint add2c = k; add2 = uaddCarry(add2, add1c, k); add2c += k;
        uint c3;
        x0 = uaddCarry(x0, lo0, k); c3 = k;
